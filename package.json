{
  "name": "toolflow",
  "version": "18.0.1",
  "private": true,
  "scripts": {
    "release:check": "node scripts/release-contract.js",
    "release:evidence": "node scripts/release-evidence.js",
    "integrity:manifest": "node scripts/public-assets.js",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:resilience": "playwright test -c config/playwright.resilience.config.js",
    "test:security": "playwright test -c config/playwright.security.config.js",
    "test:ux": "playwright test -c config/playwright.ux.config.js",
    "quality": "node scripts/quality-check.js",
    "test:a11y": "playwright test tests/accessibility.spec.js",
    "test:visual": "playwright test tests/visual.spec.js",
    "test:visual:update": "playwright test tests/visual.spec.js --update-snapshots",
    "test:domain": "playwright test tests/domain.spec.js --project=desktop-chromium",
    "test:keyboard": "playwright test tests/keyboard.spec.js --project=desktop-chromium",
    "test:cross-browser": "playwright test -c config/playwright.cross-browser.config.js",
    "test:production": "playwright test -c config/playwright.production.config.js",
    "test:lighthouse": "node scripts/lighthouse-run.js config/lighthouserc.cjs .lighthouseci",
    "test:lighthouse:mobile": "node scripts/lighthouse-run.js config/lighthouserc.mobile.cjs .lighthouseci-mobile",
    "test:visual-system": "playwright test -c config/playwright.visual-system.config.js",
    "test:design-polish": "playwright test -c config/playwright.design-polish.config.js",
    "test:experience": "playwright test -c config/playwright.experience-refinement.config.js",
    "test:review": "node --test scripts/product-review-check.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "lighthouse": "13.5.0"
  },
  "overrides": {
    "basic-ftp": "6.2.2",
    "ip-address": "10.7.1"
  }
}
