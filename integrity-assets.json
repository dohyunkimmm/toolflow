{
  "schemaVersion": 2,
  "profile": "production-critical-public-assets",
  "requiredFiles": [
    "index.html",
    "version.txt",
    "release.json",
    "integrity-assets.json",
    "styles.css",
    "login-font-lock.css",
    "experience-refinement.css",
    "visual-system.css",
    "data.js",
    "app.js",
    "og-image.png",
    "fonts/pretendard.css",
    "fonts/PRETENDARD-LICENSE.txt",
    "execution-hierarchy.css",
    "product-readiness.css",
    "typography-qa.css",
    "catalog.css",
    "fonts/TOSSFACE-LICENSE.txt",
    "fonts/TOSSFACE-NOTICE.txt",
    "font-preferences.css",
    "login-shell.css",
    "fonts/pretendard-login.css",
    "fonts/login/NOTICE.txt"
  ],
  "recursiveSets": [
    {
      "root": "js",
      "extensions": [
        ".js"
      ]
    },
    {
      "root": "icons",
      "extensions": [
        ".svg"
      ]
    },
    {
      "root": "fonts/pretendard",
      "extensions": [
        ".woff2"
      ]
    },
    {
      "root": "fonts/login",
      "extensions": [
        ".woff2"
      ]
    }
  ],
  "sourceOnlyFiles": [
    "api/recommend.js",
    "lib/recommendation.js",
    "lib/recommendation-rate-limit.js",
    "scripts/release-contract.js",
    "scripts/release-evidence.js",
    "scripts/resilience-summary.js",
    "scripts/security-summary.js",
    "scripts/ux-summary.js",
    "scripts/visual-system-summary.js",
    "scripts/public-assets.js"
  ]
}
